# Anthropic-compatible provider used by the /api/ai-move serverless route.
# The app works out of the box with these server-side defaults, and players
# can still override with their own key in the UI (sent per-request, never stored server-side).

# Base URL of an Anthropic-compatible endpoint (no trailing slash).
ANTHROPIC_BASE_URL="https://api.anthropic.com"

# Auth token / API key for that endpoint.
ANTHROPIC_AUTH_TOKEN="sk-your-key-here"
